---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  compact?: boolean;
}

const { src, alt, caption, compact = false } = Astro.props;
---

<figure class:list={[compact ? 'my-0' : 'my-8']}>
  <div class="overflow-hidden rounded-md border border-border bg-surface">
    <Image
      src={src}
      alt={alt}
      quality={92}
      class="block h-auto w-full"
      data-lightbox
      data-caption={caption || alt}
      loading="lazy"
    />
  </div>
  {caption && (
    <figcaption class="mt-2.5 text-[0.8rem] leading-relaxed text-ink-muted">
      {caption}
    </figcaption>
  )}
</figure>
