---
import '../styles/global.css';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portafolio de Analista de Datos de Leandro Joaquín Tabarcache — SQL, Python, Power BI, Excel y desarrollo Full Stack.',
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAFAF7" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink antialiased">
    <header class="sticky top-0 z-40 border-b border-border bg-canvas/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6 sm:px-10">
        <a href="/" class="group flex min-w-0 items-baseline gap-2" aria-label="Inicio — Leandro Joaquín Tabarcache">
          <span class="truncate font-serif text-[1.05rem] font-semibold tracking-tight text-ink">
            Joaquín Tabarcache
          </span>
          <span class="hidden text-sm text-ink-muted md:inline">— Analista de Datos</span>
        </a>

        <nav aria-label="Navegación principal" class="flex shrink-0 items-center gap-5 sm:gap-7">
          <a href="/#sobre-mi" class="hidden text-sm text-ink-secondary transition-colors hover:text-ink lg:inline">
            Sobre mí
          </a>
          <a href="/#proyectos" class="text-sm text-ink-secondary transition-colors hover:text-ink">
            Proyectos
          </a>
          <a href="/#contacto" class="hidden text-sm text-ink-secondary transition-colors hover:text-ink sm:inline">
            Contacto
          </a>
          <a
            href="/CV_Leandro_Joaquin_Tabarcache.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md border border-ink/80 px-3 py-1.5 text-sm font-medium text-ink transition hover:bg-ink hover:text-canvas"
          >
            CV
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 4v12" /><path d="m7 11 5 5 5-5" /><path d="M5 20h14" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-8 text-sm text-ink-muted sm:flex-row sm:items-center sm:justify-between sm:px-10">
        <p>© {year} Leandro Joaquín Tabarcache</p>
        <div class="flex flex-wrap gap-x-6 gap-y-1">
          <a href="https://www.linkedin.com/in/joaquin-tabarcache-ba9bb8271/" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">LinkedIn</a>
          <a href="https://github.com/joaquin-tabarcache" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">GitHub</a>
          <a href="mailto:tabarcachejoaquin@gmail.com" class="transition-colors hover:text-ink">Email</a>
        </div>
      </div>
    </footer>

    <Lightbox />
  </body>
</html>
